# Copy to `.env` before running `docker compose up -d --build` (or let `phonos playground`
# / `phonos production` auto-generate persistent local secrets in `.data/`).

# --- Core Security (auto-generated in `.data/` if left blank in standalone mode) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENCRYPTION_KEY=

# --- Mode & Network Access ---
PHONOS_MODE=production
PHONOS_BIND_HOST=0.0.0.0
PHONOS_LOCALNET_ONLY=1
PHONOS_TRUST_PROXY=0
LOCAL_LAB_MODE=true
ENABLE_2FA=false
ALLOW_PUBLIC_SIGNUP=true

# --- Initial Production Admin Account (optional; leave blank for Browser First-Run Setup Wizard) ---
PHONOS_ADMIN_USER=
PHONOS_ADMIN_PASSWORD=
PHONOS_LAB_NAME=Phonos Lab

# --- Database & Redis (Docker Compose uses PostgreSQL 16 + Redis; standalone defaults to SQLite + In-Memory) ---
POSTGRES_DB=phonos
POSTGRES_USER=phonos
POSTGRES_PASSWORD=replace-with-strong-db-password
# DATABASE_URL=postgresql://phonos:replace-with-strong-db-password@postgres:5432/phonos
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Bio-AI & Copilot API Keys (can also be configured encrypted from the UI Settings / Copilot panel!) ---
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Notebook Execution ---
# `auto` uses Local Python Kernel out-of-the-box and upgrades to Docker container isolation when available
NOTEBOOK_BACKEND=auto

# --- GitHub Release Updater ---
PHONOS_UPDATE_REPO=mxsp/phonos
