# Phonos Worker Deployment Configuration
# Copy this file to .env and configure with your values

# =============================================================================
# REQUIRED: Redis Connection (Main Server)
# =============================================================================
# Main server hostname - where the Phonos main app is running
REDIS_HOST=phonos.fyreflysystems.com
REDIS_PORT=6379
REDIS_DB=0

# CRITICAL: Must match the main server's Redis password exactly
REDIS_PASSWORD=your-redis-password-from-main-server

# Enable TLS for Redis (recommended for production)
REDIS_SSL=false

# =============================================================================
# REQUIRED: Encryption Key
# =============================================================================
# CRITICAL: Must be IDENTICAL to the main server's ENCRYPTION_KEY
# Get this from the main server's .env file - do NOT generate a new one
ENCRYPTION_KEY=your-encryption-key-from-main-server

# =============================================================================
# Worker Configuration
# =============================================================================
# Heartbeat interval in seconds
WORKER_HEARTBEAT_INTERVAL=30

# Maximum retry attempts for failed jobs
MAX_RETRIES=3

# Job timeouts (seconds)
ESMFOLD_JOB_TIMEOUT=600
DIFFDOCK_JOB_TIMEOUT=1200

# =============================================================================
# Performance Tuning
# =============================================================================
# CPU threading for parallel operations
OMP_NUM_THREADS=8
MKL_NUM_THREADS=6
OPENBLAS_NUM_THREADS=6
NUMEXPR_NUM_THREADS=6

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# GPU Configuration (Optional Overrides)
# =============================================================================
# By default: ESMFold=GPU0, DiffDock=GPU1
# Uncomment to use single GPU for both (not recommended)
# ESMFOLD_GPU=0
# DIFFDOCK_GPU=0

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before starting workers, ensure:
# [ ] REDIS_HOST points to main server (not localhost)
# [ ] REDIS_PASSWORD matches main server exactly
# [ ] ENCRYPTION_KEY matches main server exactly
# [ ] Can ping main server
# [ ] Network allows outbound to Redis port
# [ ] NVIDIA drivers installed (nvidia-smi works)
# [ ] Docker NVIDIA runtime installed
# [ ] Sufficient disk space (200GB+ for model caches)
