# Node1-ESM Worker Configuration
# Copy this file to .env and configure for your environment
#
# IMPORTANT: This worker runs on a SEPARATE MACHINE from the main server
# It connects to Redis on the main server (phonos.fyreflysystems.com)

# ============================================================================
# Redis Connection - Connects to Main Server
# ============================================================================
# Main server hostname (DO NOT use localhost)
REDIS_HOST=phonos.fyreflysystems.com

# Redis port (default: 6379, or 6380 if using TLS)
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# Redis password (REQUIRED - must match main server)
# Get this from the main server's .env file
REDIS_PASSWORD=your-redis-password-from-main-server

# Enable SSL/TLS for Redis connection (recommended for production)
REDIS_SSL=false

# ============================================================================
# Worker Configuration
# ============================================================================
# Worker type (do not change)
WORKER_TYPE=type-0

# Unique worker ID (change if running multiple instances)
# Format: node-type-0-<unique-identifier>
WORKER_ID=node-type-0-1

# Heartbeat interval in seconds (how often to send health updates)
WORKER_HEARTBEAT_INTERVAL=30

# Maximum retry attempts for failed jobs
MAX_RETRIES=3

# Job timeout in seconds (10 minutes default)
JOB_TIMEOUT=600

# Poll timeout in seconds (how long to wait for new jobs)
POLL_TIMEOUT=5

# ============================================================================
# Encryption - MUST MATCH MAIN SERVER
# ============================================================================
# CRITICAL: This MUST be identical to the ENCRYPTION_KEY on the main server
# Get this value from the main server's .env file
# Do NOT generate a new key - copy the exact value from main server
ENCRYPTION_KEY=your-encryption-key-from-main-server

# ============================================================================
# Model Cache Directories
# ============================================================================
# Where to cache Hugging Face models
TRANSFORMERS_CACHE=/app/cache
TORCH_HOME=/app/cache

# Model cache size limit (optional)
# HF_HOME=/app/cache

# ============================================================================
# GPU Configuration
# ============================================================================
# Preferred GPU index (0 for first GPU, 1 for second, etc.)
# ESMFold defaults to GPU 0
PREFERRED_GPU=0

# Which GPU to use (0 for first GPU, 1 for second, etc.)
# Set to empty string to use CPU only
CUDA_VISIBLE_DEVICES=0

# ============================================================================
# Logging
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# ============================================================================
# Network Configuration
# ============================================================================
# Connection timeout for Redis (seconds)
REDIS_TIMEOUT=10

# Socket connect timeout (seconds)
REDIS_CONNECT_TIMEOUT=10

# ============================================================================
# Performance Tuning
# ============================================================================
# Enable PyTorch JIT compilation (can improve performance)
PYTORCH_JIT=1

# Number of threads for PyTorch
# Set to number of CPU cores or leave empty for auto
# OMP_NUM_THREADS=8

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before starting the worker, ensure:
# [ ] REDIS_HOST points to main server (phonos.fyreflysystems.com)
# [ ] REDIS_PASSWORD matches main server exactly
# [ ] ENCRYPTION_KEY matches main server exactly
# [ ] WORKER_ID is unique (if running multiple workers)
# [ ] Can ping main server: ping phonos.fyreflysystems.com
# [ ] Can connect to Redis: redis-cli -h phonos.fyreflysystems.com -p 6379 -a <password> ping
# [ ] Firewall allows outbound connections to port 6379
# [ ] GPU drivers installed (if using GPU)
# [ ] Sufficient disk space for model cache (50GB+)
