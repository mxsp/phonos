[Unit]
Description=Phonos Node1-ESM Worker (ESMFold)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=phonos
Group=phonos
WorkingDirectory=/opt/phonos/node1-esm
Environment="PATH=/opt/phonos/node1-esm/venv/bin"
EnvironmentFile=/opt/phonos/node1-esm/.env

ExecStart=/opt/phonos/node1-esm/venv/bin/python node1-esm.py

# Restart policy
Restart=always
RestartSec=30
StartLimitInterval=600
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=8192
# Increase memory limit for ML models
LimitAS=infinity
LimitMEMLOCK=infinity

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=node1-esm

# GPU access (if using NVIDIA)
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw

[Install]
WantedBy=multi-user.target
